MediaRtmp=10001
MediaRtsp=10002
MediaRtp=10003

# WVP Web 端口改为 9080，避免与 VLStream 后端 8080 冲突
WebHttp=9080
WebHttps=9081

# Stream_IP = 拼给浏览器的播放地址 host；SDP_IP = 写进 SDP 的设备收流地址。
# 两者独立，不要一起改：本机 Docker(WSL2 mirrored) 的发布端口只有 127.0.0.1 通，
# 浏览器侧用物理网卡 IP 会一直超时（表现为"原本能播的通道改完变黑屏"）；
# 设备侧则必须是真网卡 IP，否则国标设备收不到流。
Stream_IP=127.0.0.1
SDP_IP=192.168.0.100

# SIP 服务配置（GB28181 设备接入）
SIP_ShowIP=192.168.0.100
SIP_Port=5060
SIP_Domain=3402000000
SIP_Id=34020000002000000001
SIP_Password=admin12345

RecordSip=true
RecordPushLive=

# ZLM HTTP port. Container-internal port MUST equal host-published port,
# because WVP uses media_server.http_port BOTH to call the ZLM API and to
# build browser playback URLs. Under mirrored networking the browser can
# only reach 127.0.0.1, so Stream_IP is set to 127.0.0.1 as well.
MediaHttp=8081
